# Copy this file to .env in this folder (or the repo root) and fill in real values.
# NEVER commit the real .env file.

# Telegram (required for the bot)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# MetaTrader 5 (optional - for live/paper trading via MT5)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Optional settings
# LOG_LEVEL=INFO
# DEFAULT_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
